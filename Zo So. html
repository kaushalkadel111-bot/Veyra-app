        { id:"gaming",        icon:"bi-controller",    activeIcon:"bi-controller",      label:"Hub"      },
        { id:"__create__",    label:""                                                                   },
        { id:"notifications", icon:"bi-bell",          activeIcon:"bi-bell-fill",       label:"Activity", badge:8 },
        { id:"profile",       icon:"bi-person-circle", activeIcon:"bi-person-circle",   label:"Me"       },
      ];

      return (
        <div className="bottom-nav">
          <div className="glass-nav" style={{ padding:"8px 4px 22px",
            display:"flex", alignItems:"center", justifyContent:"space-around" }}>
            {items.map(it => {
              if (it.id === "__create__") {
                return (
                  <button key="create" onClick={onPlus}
                    style={{ background:"none", border:"none", cursor:"pointer",
                      display:"flex", flexDirection:"column", alignItems:"center" }}>
                    <div className="create-ring">
                      <div className="create-inner" style={{ width:44, height:44,
                        display:"flex", alignItems:"center", justifyContent:"center" }}>
                        <i className="bi bi-plus-lg"
                          style={{ fontSize:22, color:"var(--cyan)" }} />
                      </div>
                    </div>
                  </button>
                );
              }
              return (
                <button key={it.id} onClick={() => setActive(it.id)}
                  style={{ background:"none", border:"none", cursor:"pointer",
                    display:"flex", flexDirection:"column", alignItems:"center", gap:3,
                    padding:"4px 10px", borderRadius:12, position:"relative" }}>
                  <i className={`bi ${active===it.id ? it.activeIcon : it.icon}`}
                    style={{ fontSize:22,
                      color: active===it.id ? "var(--cyan)" : "var(--z600)",
                      transition:"color .2s" }} />
                  <span style={{ fontSize:9, fontWeight:700, letterSpacing:".05em",
                    color: active===it.id ? "var(--cyan)" : "var(--z600)",
                    transition:"color .2s" }}>
                    {it.label.toUpperCase()}
                  </span>
                  {it.badge && <div className="nbadge">{it.badge}</div>}
                </button>
              );
            })}
          </div>
        </div>
      );
    }

    /* ================================================================
       APP SHELL
    ================================================================ */
    function AppShell({ user }) {
      const [tab,        setTab]        = useState("feed");
      const [showCreate, setShowCreate] = useState(false);
      const [toast,      setToast]      = useState(null);

      return (
        <div style={{ height:"100%", background:"var(--bg)", position:"relative" }}>
          <div className="max-app">
            <div style={{ height:"100%", paddingBottom: tab==="feed" ? 0 : 80 }}>
              {tab === "feed"          && <NeuralFeed />}
              {tab === "gaming"        && <GamingHub />}
              {tab === "notifications" && <NotificationsPage />}
              {tab === "profile"       && <ProfilePage user={user} />}
            </div>
            <BottomNav active={tab} setActive={setTab} onPlus={() => setShowCreate(true)} />
            {showCreate && <CreateMenu close={() => setShowCreate(false)} />}
            {toast && <Toast msg={toast} done={() => setToast(null)} />}
          </div>
        </div>
      );
    }

    /* ================================================================
       LOADING SCREEN
    ================================================================ */
    function LoadingScreen() {
      return (
        <div className="bg-mesh" style={{ height:"100%", display:"flex",
          flexDirection:"column", alignItems:"center", justifyContent:"center", gap:22 }}>
          <div className="pulse-c" style={{ width:64, height:64, borderRadius:20,
            background:"rgba(6,182,212,.08)", border:"1px solid rgba(6,182,212,.32)",
            display:"flex", alignItems:"center", justifyContent:"center" }}>
            <span className="brand" style={{ fontSize:15, fontWeight:700,
              color:"var(--cyan)", letterSpacing:".1em" }}>SZ</span>
          </div>
          <span className="brand"
            style={{ fontSize:10, color:"var(--z600)", letterSpacing:".3em" }}>
            LOADING THE EDGE
          </span>
        </div>
      );
    }

    /* ================================================================
       ROOT APP
    ================================================================ */
    function App() {
      const [state, setState] = useState("loading");
      const [user,  setUser]  = useState(null);

      useEffect(() => {
        const run = async () => {
          try {
            if (!sb) { setState("auth"); return; }
            const { data } = await sb.auth.getSession();
            if (data?.session?.user) {
              const p = await sb.from("profiles")
                .select("username").eq("id", data.session.user.id).single();
              setUser({
                email:    data.session.user.email,
                username: p.data?.username || data.session.user.email.split("@")[0],
                id:       data.session.user.id,
              });
              setState("app");
            } else {
              setState("auth");
            }
          } catch { setState("auth"); }
        };
        const t = setTimeout(run, 1100);
        return () => clearTimeout(t);
      }, []);

      const onAuth = u => { setUser(u); setState("app"); };

      return (
        <div style={{ width:"100%", height:"100%" }}>
          {state === "loading" && <LoadingScreen />}
          {state === "auth"    && <AuthScreen onAuth={onAuth} />}
          {state === "app" && user && <AppShell user={user} />}
        </div>
      );
    }

    /* ================================================================
       MOUNT
    ================================================================ */
    try {
      const loader = document.getElementById("sz-loader");
      if (loader) loader.remove();
      ReactDOM.createRoot(document.getElementById("root")).render(<App />);
    } catch (err) {
      document.getElementById("root").innerHTML = `
        <div style="height:100%;display:flex;flex-direction:column;align-items:center;
          justify-content:center;background:#09090b;padding:32px;text-align:center;gap:16px;">
          <div style="font-family:'Syncopate',sans-serif;font-size:28px;font-weight:700;
            color:#06b6d4;letter-spacing:.3em;">SU ZU</div>
          <div style="font-size:13px;color:#52525b;max-width:320px;line-height:1.7;">
            Render error — open DevTools → Console for details.<br/>
            Make sure you are running on a local server (not file:///).
          </div>
          <code style="background:#18181b;border:1px solid #27272a;border-radius:10px;
            padding:10px 18px;font-size:11px;color:#f87171;max-width:360px;word-break:break-word;">
            ${err.message}
          </code>
        </div>`;
    }
  </script>
</body>
</html>
