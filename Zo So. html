    /* ================================================================
       CREATE MENU
    ================================================================ */
    function CreateMenu({ close }) {
      const [dur,    setDur]    = useState("15s");
      const [rec,    setRec]    = useState(false);
      const [camErr, setCamErr] = useState("");
      const vidRef    = useRef(null);
      const streamRef = useRef(null);

      async function toggleCam() {
        if (rec) {
          streamRef.current?.getTracks().forEach(t => t.stop());
          setRec(false); return;
        }
        try {
          const s = await navigator.mediaDevices.getUserMedia({ video:true, audio:true });
          streamRef.current = s;
          if (vidRef.current) vidRef.current.srcObject = s;
          setRec(true);
        } catch { setCamErr("Camera access denied — check browser permissions."); }
      }

      useEffect(() => () => {
        streamRef.current?.getTracks().forEach(t => t.stop());
      }, []);

      return (
        <div className="m-backdrop" onClick={close}>
          <div className="m-sheet" onClick={e => e.stopPropagation()}>
            <div style={{ display:"flex", alignItems:"center",
              justifyContent:"space-between", marginBottom:20 }}>
              <span className="brand" style={{ fontSize:14, fontWeight:700,
                color:"var(--cyan)", letterSpacing:".15em" }}>CREATE</span>
              <i className="bi bi-x-lg"
                style={{ cursor:"pointer", color:"var(--z600)" }} onClick={close} />
            </div>

            {/* Camera preview */}
            <div style={{ borderRadius:16, overflow:"hidden", background:"#18181b",
              aspectRatio:"9/16", maxHeight:260, position:"relative", marginBottom:16 }}>
              <video ref={vidRef} autoPlay muted playsInline
                style={{ width:"100%", height:"100%", objectFit:"cover",
                  display: rec ? "block" : "none" }} />
              {!rec && (
                <div style={{ position:"absolute", inset:0, display:"flex",
                  flexDirection:"column", alignItems:"center", justifyContent:"center", gap:12 }}>
                  <i className="bi bi-camera-video"
                    style={{ fontSize:40, color:"#27272a" }} />
                  {camErr && (
                    <span style={{ fontSize:12, color:"#f87171",
                      textAlign:"center", padding:"0 20px" }}>{camErr}</span>
                  )}
                </div>
              )}
              {rec && <>
                <div style={{ position:"absolute", top:10, left:10, background:"#ef4444",
                  borderRadius:8, padding:"4px 10px",
                  display:"flex", alignItems:"center", gap:5 }}>
                  <div className="live-dot" style={{ width:6, height:6,
                    borderRadius:"50%", background:"#fff" }} />
                  <span style={{ fontSize:10, fontWeight:700, color:"#fff" }}>REC</span>
                </div>
                <div className="wm">SU ZU</div>
              </>}
            </div>

            {/* Duration */}
            <div style={{ marginBottom:16 }}>
              <span style={{ fontSize:10, color:"var(--z600)", letterSpacing:".1em",
                display:"block", marginBottom:8 }}>DURATION</span>
              <div style={{ display:"flex", gap:6 }}>
                {DURATIONS.map(d => (
                  <button key={d} onClick={() => setDur(d)} style={{
                    flex:1, padding:"8px 0", borderRadius:10, border:"none", cursor:"pointer",
                    fontFamily:"'Plus Jakarta Sans',sans-serif", fontWeight:800, fontSize:11,
                    background: dur===d ? "var(--cyan)" : "#27272a",
                    color: dur===d ? "#000" : "var(--z600)",
                    boxShadow: dur===d ? "0 0 12px rgba(6,182,212,.4)" : "none",
                    transition:"all .2s",
                  }}>{d}</button>
                ))}
              </div>
            </div>

            <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:10 }}>
              <button className="btn-cyan" onClick={toggleCam}
                style={{ padding:13, borderRadius:12, fontSize:12, letterSpacing:".05em",
                  display:"flex", alignItems:"center", justifyContent:"center", gap:8 }}>
                <i className={`bi ${rec ? "bi-stop-fill" : "bi-camera-fill"}`} />
                {rec ? "STOP" : "CAMERA"}
              </button>
              <button className="btn-ghost"
                style={{ padding:13, borderRadius:12, fontSize:12,
                  display:"flex", alignItems:"center", justifyContent:"center", gap:8 }}>
                <i className="bi bi-image" /> UPLOAD
              </button>
            </div>

            <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:8 }}>
